<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a class="site-name" href="{{ '/' | relative_url }}"><strong>Christoph</strong> Clement</a>
    <div class="site-nav-links">
      <a
        href="{{ '/' | relative_url }}"
        {% if page.permalink == '/' %}
          aria-current="page"
        {% endif %}
        >About</a
      >
      <a href="{{ '/#experience' | relative_url }}">Experience</a>
      <a href="{{ '/#education' | relative_url }}">Education</a>
      <a
        href="{{ '/blog/' | relative_url }}"
        {% if page.url contains '/blog/' %}
          aria-current="page"
        {% endif %}
        >Notes</a
      >
      <a href="{{ site.scholar_url }}">Google Scholar</a>
    </div>
  </nav>
</header>
