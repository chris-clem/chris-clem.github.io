---
layout: default
---
<article class="profile-page" id="about">
  <img
    class="profile-portrait"
    src="{{ '/assets/img/christoph-clement.png' | relative_url }}"
    alt="Christoph Clement"
    width="800"
    height="800"
    fetchpriority="high"
  >
  <header class="profile-heading">
    <h1><strong>Christoph</strong> Clement</h1>
    <p class="profile-role">Machine Learning Engineer at <a href="https://www.khumbu.ai/">Khumbu</a></p>
    <p class="profile-location">Munich, Germany</p>
  </header>
  <div class="profile-bio">{{ content }}</div>
  <nav class="profile-links" aria-label="Contact and profiles">
    <a href="mailto:{{ site.data.socials.email }}">Email</a>
    <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
    <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
    <a href="{{ site.scholar_url }}">Google Scholar</a>
  </nav>
  <section class="profile-section" id="experience" aria-labelledby="experience-title">
    <h2 id="experience-title">Experience</h2>
    {% assign experience = site.data.profile.experience | where: 'selected', true %}
    {% include profile-entries.liquid entries=experience %}
    <p class="profile-more"><a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">Full experience on LinkedIn</a></p>
  </section>
  <section class="profile-section" id="education" aria-labelledby="education-title">
    <h2 id="education-title">Education</h2>
    {% assign education = site.data.profile.education | where: 'selected', true %}
    {% include profile-entries.liquid entries=education %}
  </section>
</article>
